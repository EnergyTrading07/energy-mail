{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // Pruefdateien gehoeren nicht nach dist/. Vorher landeten 24 uebersetzte
  // *.test.mjs samt Quellkarten im ausgelieferten app.asar - nachgewiesen mit
  // "asar list". Ausgelieferter Code, den niemand geprueft hat, und in
  // routen.test.mjs steht eine vollstaendige Serverkonfiguration samt festem Schluessel.
  // Aus demselben Grund bleiben die S/MIME-Pruefdaten draussen: 30 kB Zertifikate und
  // fertige Nachrichten, die nur die Pruefung braucht. Uebersetzt landeten sie in jeder
  // ausgelieferten Fassung - samt zweier geheimer Schluessel, die zwar wertlos sind, in
  // einem Auslieferungspaket aber nichts zu suchen haben.
  "exclude": ["src/**/*.test.mts", "src/**/pruefdaten/**"]
}
