# Abhängigkeiten und Bauergebnisse - werden aus dem Quellcode erzeugt.
node_modules/
packages/*/dist/
release/

# Konten, Schlüssel und Kontakte.
#
# Gehört unter keinen Umständen in ein Repository: contacts.json steht im Klartext und
# enthält die Adressen aller Personen, mit denen korrespondiert wurde - also die Daten
# Dritter. accounts.json und key.enc liegen zwar verschlüsselt vor, der Schlüssel aber
# gleich daneben.
#
# Im Betrieb liegen diese Dateien ohnehin im Benutzerordner (%APPDATA%), nicht hier.
# Was hier noch liegt, ist ein Rückstand aus der Zeit davor und kann weg.
packages/server/data/

# Der Serverbetrieb.
#
# betrieb/.env enthält den Namen des Anschlusses und die Verwalteradresse; daten/ und
# sicherungen/ enthalten Konten, Adressbücher und den Masterschlüssel. Nichts davon
# gehört in ein Repository - und der Masterschlüssel dort wäre gleichbedeutend damit,
# sämtliche Postfach-Kennwörter zu veröffentlichen.
betrieb/.env
betrieb/daten/
betrieb/sicherungen/

# Protokolle und Zwischenstände
*.log
.DS_Store
Thumbs.db
