# Vorlage. Kopieren nach betrieb/.env und ausfüllen.
#
#   cp betrieb/.env.beispiel betrieb/.env
#
# betrieb/.env gehört NICHT ins Repository - es steht in .gitignore.

# Unter welchem Namen der Dienst erreichbar ist. Dieser Name muss im DNS auf die
# öffentliche Adresse dieses Anschlusses zeigen, sonst bekommt Caddy kein Zertifikat.
DOMAIN=mail.beispiel.de

# Wohin Let's Encrypt schreibt, wenn ein Zertifikat abzulaufen droht. Eine Adresse, die
# jemand liest - und zwar möglichst nicht eine auf diesem Server, sonst kommt die
# Warnung ausgerechnet dann nicht an, wenn er nicht läuft.
ADMIN_MAIL=hendrik@beispiel.de

# Zeitzone des Dienstes. Bestimmt, was im Protokoll steht und wie Zeiten gerechnet werden.
TZ=Europe/Berlin

# Kennzeichnung des Abbilds. Beim Aktualisieren mitziehen, dann steht in /gesundheit,
# was tatsächlich läuft.
FASSUNG=0.2.1

# ---------------------------------------------------------------------------
# Was hier bewusst NICHT steht
# ---------------------------------------------------------------------------
#
# ENERGY_MAIL_MASTER_KEY - der Masterschlüssel gehört nicht in eine Umgebungsvariable.
# Sie steht unter Linux in /proc/<pid>/environ, taucht in "docker inspect" auf und landet
# in Shell-Historien. Der Dienst legt beim ersten Start selbst eine Schlüsseldatei an:
#
#     betrieb/daten/master.key
#
# OHNE DIESE DATEI sind sämtliche hinterlegten Postfach-Kennwörter unwiederbringlich
# verloren - auch aus jeder Sicherung. Sie gehört gesichert, und zwar GETRENNT von den
# Daten: liegen beide am selben Ort, schützt die Verschlüsselung vor niemandem mehr.
#
# ENERGY_MAIL_ZUGANG - stammt aus der Zeit vor der Anmeldung und weist seinen Träger als
# den einen Einplatznutzer aus. Auf einem Server mit mehreren Menschen wäre das ein
# Generalschlüssel auf ein gemeinsames Postfach. Der Dienst warnt, wenn die Variable
# gesetzt ist.
