# Vorlage. Kopieren nach .env und ausfüllen:
#
#   cp .env.beispiel .env
#
# .env steht in .gitignore und gehört nicht ins Repository.
#
# Diese Datei muss NEBEN der docker-compose.yml liegen: Compose liest die ${...} in der
# compose-Datei ausschließlich aus seiner eigenen Umgebung und aus ./.env. Ein
# "env_file:" im Dienst würde die Werte zwar an den Container durchreichen, die
# Platzhalter in der compose-Datei aber leer lassen.

# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Unter welchem Namen der Dienst im Browser steht. Ohne diese Angabe weist der
# Herkunftsriegel die eigene Oberfläche ab - der Dienst verweigert deshalb den Start.
DOMAIN=mail.beispiel.de

# ---------------------------------------------------------------------------
# Wohin der Dienst lauscht
# ---------------------------------------------------------------------------

# Voreinstellung 127.0.0.1: nur auf diesem Rechner erreichbar.
#
# Steht der Reverse Proxy auf einem ANDEREN Rechner, gehört hier der Weg hinein, über
# den er herankommt - etwa die Tailscale-Adresse dieses Rechners. Ein leerer Wert oder
# 0.0.0.0 stellt den Dienst unverschlüsselt ins ganze Netz; das ist fast nie gemeint.
ENERGY_MAIL_BIND=127.0.0.1
ENERGY_MAIL_PORT=4000

# Wo die Daten liegen. Wird der Ordner erst angelegt, muss er dem Nutzer mit der Nummer
# 1000 gehören - unter dieser Nummer läuft der Dienst im Container.
ENERGY_MAIL_DATENORDNER=./betrieb/daten

# ---------------------------------------------------------------------------
# Beiwerk
# ---------------------------------------------------------------------------

TZ=Europe/Berlin

# Obergrenze für den Arbeitsspeicher. Auf einem Rechner, der noch andere Dienste trägt,
# die wichtigere der beiden Zahlen.
ENERGY_MAIL_SPEICHER=1500m

# Kennzeichnung des Abbilds. Beim Aktualisieren mitziehen, dann steht in /gesundheit,
# was tatsächlich läuft.
FASSUNG=0.2.1

# Nur für docker-compose.caddy.yml: an diese Adresse schreibt Let's Encrypt, bevor ein
# Zertifikat abläuft.
ADMIN_MAIL=verwalter@beispiel.de

# ---------------------------------------------------------------------------
# Was hier bewusst NICHT steht
# ---------------------------------------------------------------------------
#
# ENERGY_MAIL_MASTER_KEY - der Masterschlüssel gehört nicht in eine Umgebungsvariable.
# Sie steht unter Linux in /proc/<pid>/environ, taucht in "docker inspect" auf und landet
# in Shell-Historien. Der Dienst legt beim ersten Start selbst eine Schlüsseldatei an:
#
#     betrieb/daten/master.key
#
# OHNE DIESE DATEI sind sämtliche hinterlegten Postfach-Kennwörter unwiederbringlich
# verloren - auch aus jeder Sicherung. Sie gehört gesichert, und zwar GETRENNT von den
# Daten: liegen beide am selben Ort, schützt die Verschlüsselung vor niemandem.
#
# ENERGY_MAIL_ZUGANG - stammt aus der Zeit vor der Anmeldung und weist seinen Träger als
# den einen Einplatznutzer aus. Auf einem Server mit mehreren Menschen wäre das ein
# Generalschlüssel auf ein gemeinsames Postfach. Der Dienst warnt, wenn die Variable
# gesetzt ist.
